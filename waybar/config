{
    "layer": "top",
    "position": "top",
    "height": 25,
    "spacing": 0,
    "output": "eDP-1",
    "modules-left": ["hyprland/workspaces"],
    "modules-center": ["clock"],
    "modules-right": ["idle_inhibitor", "power-profiles-daemon", "group/quicksettings", "backlight", "tray", "group/power", "custom/updates"],

    "backlight": {
        "device": "intel_backlight",
        "format": "{icon} {percent}%",
        "format-icons": ["", "", "", "", "", "", "", "", ""],
        "on-scroll-up": "brightnessctl set 5%+",
        "on-scroll-down": "brightnessctl set 5%-",
        "min-length": 6
    },

    "group/quicksettings": {
        "orientation": "inherit",
        "modules": [
            "pulseaudio",
            "custom/network",
            "bluetooth",
            "battery"
        ]
    },

    "custom/network": {
        "format": "{}",
        "interval": 3,
        "return-type": "json",
        "exec": "~/.config/hypr/waybar_network.sh",
        "on-click": "foot nmtui",
        "tooltip": true
    },

    "mpris": {
        "format": "{player_icon} {title} - {artist} [{position}/{length}]",
        "format-paused": "{status_icon} <i>{title} - {artist}</i>",
        "player-icons": {
            "default": "▶",
            "spotify": "",
            "firefox": "" 
        },
        "status-icons": {
            "paused": "⏸"
        },
        "max-length": 40,
        "on-click": "playerctl play-pause",
        "on-click-right": "playerctl next",
        "on-click-middle": "playerctl previous",
        "on-scroll-up": "playerctl next",
        "on-scroll-down": "playerctl previous"
    },

    "group/power": {
        "orientation": "inherit",
        "drawer": {
            "transition-duration": 500,
            "children-class": "not-power",
            "transition-left-to-right": false
        },
        "modules": [
            "custom/power", 
            "custom/lock",
            "custom/suspend",
            "custom/reboot",
            "custom/quit"
        ]
    },

    "idle_inhibitor": {
        "format": "{icon}",
        "format-icons": {
            "activated": "",
            "deactivated": ""
        }
    },

    "power-profiles-daemon": {
        "format": "{icon}",
        "tooltip-format": "Power profile: {profile}",
        "format-icons": {
            "performance": "",
            "balanced": "",
            "power-saver": ""
        }
    },

    "custom/power": {
        "format": "⏻",
        "tooltip": true,
        "tooltip-format": "Apagar sistema",
        "on-click": "~/.config/hypr/confirm_power.sh \"¿Apagar el sistema?\" \"shutdown now\""
    },
    "custom/suspend": {
        "format": "󰤄",
        "tooltip": true,
        "tooltip-format": "Suspender",
        "on-click": "~/.config/hypr/confirm_power.sh \"¿Suspender el sistema?\" \"loginctl lock-session && sleep 1 && hyprctl dispatch dpms off && systemctl suspend\""
    },
    "custom/quit": {
        "format": "󰗼",
        "tooltip": true,
        "tooltip-format": "Cerrar sesión",
        "on-click": "~/.config/hypr/confirm_power.sh \"¿Cerrar sesión?\" \"hyprctl dispatch exit\""
    },
    "custom/lock": {
        "format": "󰌾",
        "tooltip": true,
        "tooltip-format": "Bloquear pantalla",
        "on-click": "hyprlock & sleep 2 && hyprctl dispatch dpms off"
    },
    "custom/reboot": {
        "format": "󰜉",
        "tooltip": true,
        "tooltip-format": "Reiniciar",
        "on-click": "~/.config/hypr/confirm_power.sh \"¿Reiniciar el sistema?\" \"reboot\""
    },

    "custom/updates": {
        "format": "{text}",
        "interval": 3600,
        "return-type": "json",
        "exec": "~/.config/hypr/check_updates.sh",
        "on-click": "foot sh -c 'sudo apt update && sudo apt upgrade -y; pkill -SIGRTMIN+8 waybar; echo \"Sistema actualizado. Presiona cualquier tecla para cerrar...\"; read -n 1'",
        "signal": 8,
        "tooltip": false,
        "hide-empty-text": true
    },

    "hyprland/workspaces": {
        "format": "{name}",
        "on-click": "activate",
        "all-outputs": true,
        "sort-by-number": true
    },

    "hyprland/window": {
        "format": "{}",
        "max-length": 40,
        "separate-outputs": true
    },

    "tray": {
        "spacing": 10
    },

    "clock": {
        "timezone": "America/Argentina/Buenos_Aires",
        "format": " {:%H:%M   %d/%m}",
        "tooltip": true,
        "tooltip-format": "<big>{:%Y %B}</big>\n<tt><small>{calendar}</small></tt>",
        "on-click": "gnome-calendar",
        "actions":  {
            "on-click-middle": "shift_up",
            "on-click-right": "mode",
            "on-click-forward": "tz_up",
            "on-click-backward": "tz_down",
            "on-scroll-up": "shift_up",
            "on-scroll-down": "shift_down"
        }
    },

    "cpu": {
        "format": " {usage}%",
        "tooltip": false
    },

    "memory": {
        "format": " {}%"
    },

    "battery": {
        "states": {
            "warning": 30,
            "critical": 15
        },
        "format": "{icon} {capacity}%",
        "format-charging": " {capacity}%",
        "format-plugged": " {capacity}%",
        "format-icons": ["", "", "", "", ""]
    },

    "bluetooth": {
        "format": "󰂯",
        "format-disabled": "󰂲",
        "format-connected": "󰂱",
        "format-connected-battery": "󰂱 {device_battery_percentage}%",
        "tooltip-format": "{status}",
        "tooltip-format-connected": "{device_alias}",
        "tooltip-format-connected-battery": "{device_alias}\nBatería: {device_battery_percentage}%",
        "on-click": "blueman-manager"
    },

    "pulseaudio": {
        "format": "{icon} {volume}%",
        "format-bluetooth": "󰂯 {icon} {volume}%",
        "format-bluetooth-muted": "󰂯 󰝟 {icon}",
        "format-muted": "󰝟 {volume}%",
        "format-icons": {
            "headphone": "󰋋",
            "hands-free": "󰋎",
            "headset": "󰋎",
            "phone": "󰏲",
            "portable": "󰏲",
            "car": "󰄄",
            "default": ["󰕿", "󰖀", "󰕾"]
        },
        "on-click": "XDG_CURRENT_DESKTOP=GNOME gnome-control-center sound"
    }
}
