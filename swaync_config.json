{
  "positionX": "right",
  "positionY": "top",
  "layer": "overlay",
  "control-center-width": 380,
  "control-center-height": 860,
  "cssPriority": "user",
  "notification-window-width": 380,
  "timeout": 6,
  "timeout-low": 3,
  "timeout-critical": 0,
  "fit-to-screen": true,
  "keyboard-shortcuts": true,
  "image-visibility": "when-available",
  "transition-time": 200,
  "hide-on-clear": false,
  "hide-on-action": true,
  "script-fail-notify": true,
  "widgets": ["title", "dnd", "calendar", "notifications"],
  "widget-config": {
    "title": {
      "text": "Notificaciones",
      "clear-all-button": true,
      "button-text": "Limpiar"
    },
    "dnd": {
      "text": "No molestar"
    },
    "calendar": {
      "label": "",
      "position": "top"
    },
    "mpris": {
      "image-size": 96,
      "image-radius": 6
    }
  }
}
