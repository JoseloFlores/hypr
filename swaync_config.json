{
  "$schema": "/etc/xdg/swaync/configSchema.json",
  "positionX": "center",
  "positionY": "top",
  "layer": "overlay",
  "control-center-layer": "top",
  "layer-shell": true,
  "layer-shell-cover-screen": false,
  "cssPriority": "user",
  "control-center-margin-top": 32,
  "control-center-margin-bottom": 32,
  "control-center-margin-right": 32,
  "control-center-margin-left": 32,
  "notification-2fa-action": true,
  "notification-inline-replies": false,
  "notification-icon-size": 48,
  "notification-body-image-height": 100,
  "notification-body-image-width": 200,
  "timeout": 10,
  "timeout-low": 5,
  "timeout-critical": 0,
  "fit-to-screen": false,
  "relative-timestamps": true,
  "control-center-width": 440,
  "control-center-height": 660,
  "notification-window-width": 420,
  "keyboard-shortcuts": true,
  "image-visibility": "when-available",
  "transition-time": 200,
  "hide-on-clear": false,
  "hide-on-action": true,
  "text-empty": "No Notifications",
  "script-fail-notify": true,
  "widgets": [
    "inhibitors",
    "title",
    "dnd",
    "mpris",
    "volume",
    "backlight",
    "buttons-grid",
    "notifications"
  ],
  "widget-config": {
    "inhibitors": {
      "text": "Inhibitors",
      "button-text": "Clear All",
      "clear-all-button": true
    },
    "title": {
      "text": "Notifications",
      "clear-all-button": true,
      "button-text": "Clear All"
    },
    "dnd": {
      "text": "Do Not Disturb"
    },
    "mpris": {
      "image-size": 96,
      "image-radius": 12,
      "blur": true
    },
    "volume": {
      "label": "Volumen",
      "show-per-app": false
    },
    "backlight": {
      "label": "Brillo",
      "device": "intel_backlight",
      "subsystem": "backlight"
    },
    "buttons-grid": {
      "actions": [
        {
          "label": "\uf1eb",
          "type": "normal",
          "command": "nm-connection-editor"
        },
        {
          "label": "\uf023",
          "type": "normal",
          "command": "hyprlock"
        },
        {
          "label": "\uf03e",
          "type": "normal",
          "command": "grim -g \"$(slurp)\" - | wl-copy -n"
        },
        {
          "label": "\uf011",
          "type": "normal",
          "command": "~/.config/hypr/power_menu.sh"
        }
      ]
    }
  }
}